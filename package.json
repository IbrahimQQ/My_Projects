{
  "name": "dual-language-learning-app",
  "version": "1.0.0",
  "description": "Electron app for learning Arabic and Chinese simultaneously",
  "main": "dist/main.js",
  "scripts": {
    "start": "concurrently \"npm run start:react\" \"wait-on http://localhost:3000 && npm run start:electron\"",
    "start:react": "webpack serve --mode development --config webpack.renderer.config.js",
    "start:electron": "electron .",
    "build": "npm run build:react && npm run build:electron",
    "build:react": "webpack --mode production --config webpack.renderer.config.js",
    "build:electron": "tsc -p tsconfig.main.json",
    "package": "electron-builder"
  },
  "keywords": ["electron", "react", "typescript", "language-learning", "arabic", "chinese"],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "concurrently": "^8.2.0",
    "css-loader": "^6.8.0",
    "electron": "^27.0.0",
    "electron-builder": "^24.6.0",
    "html-webpack-plugin": "^5.5.0",
    "style-loader": "^3.3.0",
    "ts-loader": "^9.4.0",
    "typescript": "^5.0.0",
    "wait-on": "^7.0.0",
    "webpack": "^5.88.0",
    "webpack-cli": "^5.1.0",
    "webpack-dev-server": "^4.15.0"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "build": {
    "appId": "com.duallanguage.learningapp",
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    }
  }
}
