{
  "name": "html-book-builder",
  "version": "1.0.0",
  "description": "No-Code Interactive HTML Book Builder - Create interactive HTML books like Seeing Theory without coding",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux"
  },
  "keywords": [
    "html",
    "book",
    "builder",
    "interactive",
    "education",
    "visualization"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "dependencies": {
    "codemirror": "^6.0.1",
    "@codemirror/lang-html": "^6.4.7",
    "@codemirror/lang-css": "^6.2.1",
    "@codemirror/lang-javascript": "^6.2.1",
    "marked": "^11.0.0",
    "dompurify": "^3.0.6",
    "uuid": "^9.0.1",
    "mammoth": "^1.6.0"
  },
  "build": {
    "appId": "com.htmlbookbuilder.app",
    "productName": "HTML Book Builder",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "bundled-libs",
        "to": "bundled-libs"
      }
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
